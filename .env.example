# SynapseOS production environment template.
# Use a Neon pooled PostgreSQL connection string for DATABASE_URL.

DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth
NEXTAUTH_URL="https://your-synapseos-domain.vercel.app"
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
AUTH_SECRET="replace-with-the-same-32-byte-random-secret"

# Public app URL used by metadata and redirects.
NEXT_PUBLIC_APP_URL="https://your-synapseos-domain.vercel.app"

# Optional OAuth provider.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Demo/admin seed values. Override before running `npm run db:seed`.
DEFAULT_ADMIN_EMAIL="admin@synapseos.dev"
DEFAULT_ADMIN_PASSWORD="replace-with-a-secure-admin-password"
DEFAULT_ADMIN_NAME="SynapseOS Admin"
DEMO_SEED_ON_STARTUP="false"
