# SynapseOS environment template.
# Copy to `.env` locally and replace placeholders with real values.
# Never commit `.env` or production secrets.

DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=verify-full"

# Auth.js / NextAuth.
NEXTAUTH_URL="https://YOUR_APP_DOMAIN"
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
AUTH_SECRET="replace-with-the-same-32-byte-random-secret"

# Public app URL used by metadata and redirects.
NEXT_PUBLIC_APP_URL="https://YOUR_APP_DOMAIN"

# Optional OAuth provider.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Demo/admin seed values. Replace before running `npm run db:seed`.
DEFAULT_ADMIN_EMAIL="admin@example.com"
DEFAULT_ADMIN_PASSWORD="replace-with-a-secure-admin-password"
DEFAULT_ADMIN_NAME="SynapseOS Admin"
DEMO_SEED_ON_STARTUP="false"
